# Copy values into your host's secret manager (Render / Railway / Vercel / Fly).
# Never commit real secrets.

# --- Server ---
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ecommerce?schema=public
REDIS_URL=redis://REDIS_HOST:6379
CLIENT_URL=https://your-frontend.vercel.app
PUBLIC_API_URL=https://your-api.onrender.com
JWT_SECRET=replace-with-32-plus-random-chars
JWT_REFRESH_SECRET=replace-with-different-32-plus-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STRIPE_SECRET_KEY=sk_live_or_sk_test
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd
BCRYPT_SALT_ROUNDS=12
TAX_RATE=0.08
SHIPPING_FLAT_RATE=5.99
FREE_SHIPPING_THRESHOLD=75

# --- Client (VITE_* only — these are public) ---
VITE_API_URL=https://your-api.onrender.com/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test
VITE_SITE_URL=https://your-frontend.vercel.app
