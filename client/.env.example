# Client environment variables
# Copy to .env and adjust as needed

# Base URL of the Express API (use /api with Vite proxy in development)
VITE_API_URL=/api

# Stripe publishable key only (never put secret keys here — Vite inlines VITE_* into the browser bundle)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Canonical site origin for sitemap / Open Graph
VITE_SITE_URL=http://localhost:5173
