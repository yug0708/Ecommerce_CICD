NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ecommerce?schema=public
REDIS_URL=redis://REDIS_HOST:6379
CLIENT_URL=https://your-store.example.com
PUBLIC_API_URL=https://your-api.example.com
JWT_SECRET=replace-with-32-plus-random-chars
JWT_REFRESH_SECRET=replace-with-different-32-plus-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd
BCRYPT_SALT_ROUNDS=12
TAX_RATE=0.08
SHIPPING_FLAT_RATE=5.99
FREE_SHIPPING_THRESHOLD=75
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
