# Server environment variables
# Copy to .env and adjust as needed

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# JWT — use long random secrets in production (min 16 chars each)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS — frontend origin
CLIENT_URL=http://localhost:5173

# Logging — optional override (default: debug in development, info in production)
# LOG_LEVEL=info

# Rate limiting (general API)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth login brute-force protection
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

# Password reset token lifetime (minutes)
PASSWORD_RESET_EXPIRES_MINUTES=60

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# Checkout pricing
TAX_RATE=0.08
SHIPPING_FLAT_RATE=5.99
FREE_SHIPPING_THRESHOLD=75

# Stripe (use test keys in development)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd

# Optional Redis for catalog response cache (falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# Public API origin when the SPA is hosted on a different domain (enables SameSite=None cookies)
# PUBLIC_API_URL=https://api.example.com
